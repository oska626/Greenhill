# Local development only. Set these names in the Vercel project for deployment.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR_SERVER_SIDE_API_KEY
AZURE_OPENAI_DEPLOYMENT_NAME=YOUR_CHAT_COMPLETIONS_DEPLOYMENT
# Optional for the classic Azure OpenAI endpoint; defaults to 2024-10-21.
AZURE_OPENAI_API_VERSION=2024-10-21
